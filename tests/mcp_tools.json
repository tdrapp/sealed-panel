    "name": "aggregate",
    "output_schema": {
      "description": "An aggregated round. The author reads the findings file, not the numbers.",
      "properties": {
        "feedback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the author's findings file (loop round)"
        },
        "inbox": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "learning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
