        },
        "round": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "round number; optional for the sealed panel (1)"
        },
        "run": {
          "description": "the run directory",
          "type": "string"
