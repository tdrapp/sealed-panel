  {
    "annotations": {
      "open_world_hint": false,
      "read_only_hint": true
    },
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "run": {
          "description": "the run directory",
          "type": "string"
        }
      },
      "required": [
        "run"
      ],
      "type": "object"
    },
    "name": "status",
    "output_schema": {
      "description": "The stop rule's decision, read only.",
      "properties": {
        "decision": {
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "type": "object"
        },
        "overrides": {
          "description": "every setting that differs from the defaults",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "served": {
          "description": "whether this server's configuration is the run's: only then do the tools that change a run accept it",
          "type": "boolean"
        },
        "transcripts": {
          "description": "where `record` reads transcripts from, or why it reads none",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "overrides",
        "served",
        "transcripts",
        "details"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "open_world_hint": false,
