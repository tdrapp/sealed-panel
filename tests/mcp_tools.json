    },
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "run": {
          "description": "the run directory",
          "type": "string"
        }
      },
      "required": [
        "run"
      ],
      "type": "object"
    },
    "name": "report",
    "output_schema": {
      "description": "The run's report, in markdown.",
      "properties": {
        "markdown": {
          "type": "string"
        }
      },
      "required": [
        "markdown"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "open_world_hint": false,
      "read_only_hint": true
    },
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "the kind of text, such as email or cv",
          "type": "string"
        },
        "library": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "user rubric library; default: the run's, else the user library"
        },
        "run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the text file; its keywords only break ties"
        },
        "top": {
          "default": 3,
          "description": "how many templates",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "name": "rubrics_suggest",
    "output_schema": {
      "description": "The templates for a kind of text, best first; empty when none matches.",
      "properties": {
        "all_templates": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "every template's when_to_use, when none matched",
          "type": "object"
        },
        "kind": {
          "type": "string"
        },
        "suggestions": {
          "items": {
            "description": "A template for the kind of text: when to use it, its dimensions.",
            "properties": {
              "dimensions": {
                "items": {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "string"
                    }
                  ],
                  "type": "array"
                },
                "type": "array"
              },
              "id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "version": {
                "type": "integer"
              },
              "when_to_use": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "version",
              "source",
              "when_to_use",
              "dimensions"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "suggestions"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructive_hint": false,
      "open_world_hint": false,
      "read_only_hint": false
    },
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "the template id, from rubrics_suggest",
          "type": "string"
        },
        "library": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "user rubric library; default: the run's, else the user library"
        },
        "out": {
          "description": "where to write the spec; refused if it exists",
          "type": "string"
        },
        "persona_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a JSON list of personas (id, description)"
        },
        "run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "out"
      ],
      "type": "object"
    },
    "name": "rubrics_use",
    "output_schema": {
      "description": "A spec skeleton written from a template. `init` refuses it until every marker is\nfilled.",
      "properties": {
        "path": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "todo_marker": {
          "description": "the marker left in every field a person fills",
          "type": "string"
        }
      },
      "required": [
        "path",
        "template",
        "todo_marker"
      ],
      "type": "object"
    }
  }
]
