[
  {
    "annotations": {
      "destructive_hint": false,
      "open_world_hint": false,
      "read_only_hint": false
    },
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "library": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "user rubric library; default: the run's, else the user library"
        },
        "run": {
          "description": "the run directory",
          "type": "string"
        },
        "spec": {
          "description": "the spec JSON file",
          "type": "string"
        }
      },
      "required": [
        "run",
        "spec"
      ],
      "type": "object"
    },
    "name": "init",
    "output_schema": {
      "description": "A frozen run.",
      "properties": {
        "rubric_sha256": {
          "type": "string"
        },
        "run": {
          "type": "string"
        }
      },
      "required": [
        "run",
        "rubric_sha256"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructive_hint": false,
      "open_world_hint": false,
      "read_only_hint": false
    },
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "artefact": {
          "description": "the candidate text file",
          "type": "string"
        },
        "control": {
          "description": "the deliberately bad version",
          "type": "string"
        },
        "good": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a known-good the user validated"
        },
        "round": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "round number; optional for the sealed panel (1)"
        },
        "run": {
          "description": "the run directory",
          "type": "string"
        },
        "sealed": {
          "default": false,
          "description": "brief the sealed panel: after CONVERGED, PLATEAU or CAP, or as a one-shot grade; the control is the loop's",
          "type": "boolean"
        }
      },
      "required": [
        "run",
        "artefact",
        "control"
      ],
      "type": "object"
    },
    "name": "brief",
    "output_schema": {
      "description": "The briefs of one round, one per judge.",
      "properties": {
        "briefs": {
          "description": "one brief file per judge, in judge order",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "round": {
          "type": "integer"
        },
        "run": {
          "type": "string"
        },
        "sealed": {
          "type": "boolean"
        }
      },
      "required": [
        "run",
        "round",
        "sealed",
        "briefs"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructive_hint": false,
      "open_world_hint": false,
      "read_only_hint": false
    },
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "description": "the judge's context id, new in the run",
          "type": "string"
        },
        "judge": {
          "description": "the judge slot, as in brief_j<J>.md",
          "type": "integer"
        },
        "reply": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the reply text, unchanged"
        },
        "reply_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the reply saved to a file"
        },
        "round": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "round number; optional for the sealed panel (1)"
        },
        "run": {
          "description": "the run directory",
          "type": "string"
        },
        "sealed": {
          "default": false,
          "description": "the sealed panel instead of a loop round",
          "type": "boolean"
        },
        "transcript": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the judge's JSONL transcript (best proof)"
        },
        "void": {
          "default": false,
          "description": "the agent received the brief and never replied (needs its transcript, holding the brief id); a void never fills a seat",
          "type": "boolean"
        }
      },
      "required": [
        "run",
        "judge",
        "agent_id"
      ],
      "type": "object"
    },
    "name": "record",
    "output_schema": {
      "description": "One recorded attempt: a valid reply, a rejected one, or a void.",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "judge": {
          "type": "integer"
        },
        "source": {
          "type": "string"
        },
        "status": {
          "enum": [
            "VALID",
            "REJECTED",
            "VOID"
          ],
          "type": "string"
        }
      },
      "required": [
        "judge",
        "agent_id",
        "status",
        "errors",
        "source"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructive_hint": false,
      "open_world_hint": true,
      "read_only_hint": false
    },
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "judges": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "only these judge slots (default: every open one)"
        },
        "round": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "round number; optional for the sealed panel (1)"
        },
        "run": {
          "description": "the run directory",
          "type": "string"
        },
        "sealed": {
          "default": false,
          "description": "the sealed panel instead of a loop round",
          "type": "boolean"
        }
      },
      "required": [
        "run"
      ],
      "type": "object"
    },
    "name": "judge",
    "output_schema": {
      "description": "The open seats of a round, each answered by one fresh judge process.",
      "properties": {
        "round": {
          "type": "integer"
        },
        "run": {
          "type": "string"
        },
        "sealed": {
          "type": "boolean"
        },
        "seats": {
          "items": {
            "description": "One judge process started by the runner, and what was recorded.",
            "properties": {
              "agent_id": {
                "type": "string"
              },
              "duration_s": {
                "type": "number"
              },
              "errors": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "exit_code": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "judge": {
                "type": "integer"
              },
              "source": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "VALID",
                  "REJECTED",
                  "VOID"
                ],
                "type": "string"
              },
              "stderr_log": {
                "type": "string"
              }
            },
            "required": [
              "judge",
              "agent_id",
              "status",
              "errors",
              "source",
              "duration_s",
              "exit_code",
              "stderr_log"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "skipped": {
          "description": "seats another call took meanwhile (judged or filled)",
          "items": {
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "run",
        "round",
        "sealed",
        "seats"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructive_hint": false,
